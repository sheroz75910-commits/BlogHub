
<% if ((error && error.length > 0) || (success && success.length > 0)) { %>
    <div id="flash-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 items-end">
        <% if (error && error.length > 0) { %>
            <% error.forEach(function(msg, idx){ %>
                <div class="flash-popup flash-error transform transition duration-300 ease-out translate-y-0 opacity-100 max-w-sm w-full bg-red-600 text-white p-3 rounded shadow-lg ring-1 ring-red-700/30" role="alert" aria-live="assertive">
                    <div class="flex items-start gap-3">
                        <div class="flex-1 text-sm"><%= msg %></div>
                        <button class="flash-close text-white opacity-90 hover:opacity-100 text-lg leading-none">&times;</button>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <% if (success && success.length > 0) { %>
            <% success.forEach(function(msg, idx){ %>
                <div class="flash-popup flash-success transform transition duration-300 ease-out translate-y-0 opacity-100 max-w-sm w-full bg-emerald-600 text-white p-3 rounded shadow-lg ring-1 ring-emerald-700/30" role="status" aria-live="polite">
                    <div class="flex items-start gap-3">
                        <div class="flex-1 text-sm"><%= msg %></div>
                        <button class="flash-close text-white opacity-90 hover:opacity-100 text-lg leading-none">&times;</button>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
<% } %>
